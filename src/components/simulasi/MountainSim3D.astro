        }
        if (tint !== a.tint) {
          a.tint = tint; col.setScalar(tint);
          birdBodyM.setColorAt(a.idx, col); birdWingRM.setColorAt(a.idx, col); birdWingLM.setColorAt(a.idx, col);
          birdBodyM.instanceColor.needsUpdate = birdWingRM.instanceColor.needsUpdate = birdWingLM.instanceColor.needsUpdate = true;
        }
      } else {
        monkeyBodyM.setMatrixAt(a.idx, root.matrix);
        const isDead = a.state === 'dead' || a.state === 'gone';
        const freq = fast ? 17 : 10, swing = moving ? Math.sin(time * freq + a.phase) * (fast ? 0.8 : 0.52) : 0;
        const limbARx = isDead ? 0.68 * deadFall : swing;
        const limbBRx = isDead ? -0.42 * deadFall : -swing;
        const limbRz = isDead ? side * 0.24 * deadFall : 0;
        part.position.set(0, 0.22, 0); part.rotation.set(limbARx, 0, limbRz); part.scale.set(1, 1, 1); part.updateMatrix();
        mat.multiplyMatrices(root.matrix, part.matrix); monkeyLimbAM.setMatrixAt(a.idx, mat);
        part.rotation.set(limbBRx, 0, -limbRz * 0.85); part.updateMatrix();
        mat.multiplyMatrices(root.matrix, part.matrix); monkeyLimbBM.setMatrixAt(a.idx, mat);
        const tailRx = isDead ? -1.1 * deadFall : (moving ? Math.cos(time * freq + a.phase) * 0.2 : Math.sin(time * 2 + a.phase) * 0.1);
        const tailRy = isDead ? side * 0.35 * deadFall : Math.sin(time * (moving ? 8 : 3.2) + a.phase) * 0.4;
        const tailRz = isDead ? side * 0.45 * deadFall : 0;
        part.position.set(0, 0.18, -0.11); part.rotation.set(tailRx, tailRy, tailRz); part.updateMatrix();
        mat.multiplyMatrices(root.matrix, part.matrix); monkeyTailM.setMatrixAt(a.idx, mat);
        if (tint !== a.tint) {
          a.tint = tint; col.setScalar(tint);
          monkeyBodyM.setColorAt(a.idx, col); monkeyLimbAM.setColorAt(a.idx, col); monkeyLimbBM.setColorAt(a.idx, col); monkeyTailM.setColorAt(a.idx, col);
          monkeyBodyM.instanceColor.needsUpdate = monkeyLimbAM.instanceColor.needsUpdate = monkeyLimbBM.instanceColor.needsUpdate = monkeyTailM.instanceColor.needsUpdate = true;
        }
      }
    }
    for (const m of ALL_WILD_MESHES) m.instanceMatrix.needsUpdate = true;
  }

  let lastAlive = -1;
  function updateWildHUD() {
    let alive = 0; for (const a of animals) if (a.state !== 'dead' && a.state !== 'gone') alive++;
    if (alive !== lastAlive) { lastAlive = alive; $('wild').textContent = alive + ' / ' + animals.length; }
  }
  initAnimals();

  const clock = new THREE.Clock();
  let lastSkyHex = '';
  let rafId = 0;
  const flameCol = (u, i, col) => {
    const f = Math.min(1, u * 1.6);
    col[i * 3] = f; col[i * 3 + 1] = (0.3 + 0.5 * u) * f; col[i * 3 + 2] = 0.05 * f;
  };
  const smokeCol = (u, i, col) => {
    const g = 0.3, k = 1 - u;
    col[i * 3] = g + (sky.r - g) * k; col[i * 3 + 1] = g + (sky.g - g) * k; col[i * 3 + 2] = g + (sky.b - g) * k;
  };
  const mudCol = (u, i, col) => { col[i * 3] = 0.42; col[i * 3 + 1] = 0.29; col[i * 3 + 2] = 0.17; };

  function animate() {
    rafId = requestAnimationFrame(animate);
    if (document.hidden) {
      clock.getDelta();
      return;
    }
    const dt = Math.min(clock.getDelta(), 0.05), time = clock.elapsedTime;
    const raining = Date.now() < rainUntil;
    rainF += ((raining ? 1 : 0) - rainF) * Math.min(1, dt * 2);

    let burning = 0;
    for (let i = 0; i < N; i++) {
      const c = cells[i];
      if (c.vis !== c.st) refreshCellTrees(i);
      if (c.st === 'b') {
        burning++;
        for (let k = 0; k < 1; k++) {
          const p = randPoint(i);
          spawn(flames, p.x, p.y + 0.05, p.z, (Math.random() - 0.5) * 0.3, 1.0 + Math.random() * 1.0, (Math.random() - 0.5) * 0.3, 0.5 + Math.random() * 0.6);
        }
        if (Math.random() < 0.35) {
          const p = randPoint(i);
          spawn(smoke, p.x, p.y + 0.3, p.z, (Math.random() - 0.5) * 0.3 + 0.15, 0.6 + Math.random() * 0.5, (Math.random() - 0.5) * 0.3, 2.5 + Math.random() * 1.5);
        }
      }
    }

    if (raining) {
      for (let i = 0; i < N; i++) {
        const c = cells[i];
        const isBareSlope = (c.st === 'x' || c.st === 'g' || c.st === 'b') && Math.floor(i / NS) <= 3;
        if (c.slide) {
          if (Math.random() < 0.3) {
            const p = randPoint(i);
            const m = mud.ptr;
            spawn(mud, p.x, p.y + 0.04, p.z, 0, 0, 0, 3);
            mudVel[m] = 0.5 + Math.random() * 0.7;
          }
        } else if (isBareSlope) {
          if (Math.random() < 0.18) {
            const p = randPoint(i);
            const m = mud.ptr;
            spawn(mud, p.x, p.y + 0.04, p.z, 0, 0, 0, 3);
            mudVel[m] = 0.35 + Math.random() * 0.55;
          }
        }
      }
    }
    if (mud.active > 0) {
      for (let i = 0; i < mud.n; i++) {
        if (mud.life[i] <= 0) continue;
        let x = mud.pos[i * 3], z = mud.pos[i * 3 + 2];
        const e = 0.08;
        const gx = hgt(x + e, z) - hgt(x - e, z), gz = hgt(x, z + e) - hgt(x, z - e);
        const gl = Math.hypot(gx, gz);
        let dx, dz;
        if (gl < 0.002) { const rr = Math.hypot(x, z) || 1; dx = x / rr; dz = z / rr; }
        else { dx = -gx / gl; dz = -gz / gl; }
        x += dx * mudVel[i] * dt; z += dz * mudVel[i] * dt;
        if (Math.hypot(x, z) > R + 0.9) { mud.life[i] = 0.0001; continue; }
        mud.pos[i * 3] = x; mud.pos[i * 3 + 2] = z; mud.pos[i * 3 + 1] = ground(x, z) + 0.04;
      }
    }

    stepSlides(dt);
    stepAnimals(dt, time);
    stepPool(flames, dt, flameCol);
    stepPool(smoke, dt, smokeCol);
    stepPool(mud, dt, mudCol);

    rainLines.visible = rainF > 0.02;
    rainMat.opacity = 0.55 * rainF;
    if (rainLines.visible) {
      for (let i = 0; i < RN; i++) {
        const d = rd[i];
        d.y -= d.v * dt;
        if (d.y < 0) d.y += RAIN_H;
        const o = i * 6;
        rainPos[o] = d.x; rainPos[o + 1] = d.y; rainPos[o + 2] = d.z;
        rainPos[o + 3] = d.x - 0.04; rainPos[o + 4] = d.y + 0.60; rainPos[o + 5] = d.z;
      }
      rainGeo.attributes.position.needsUpdate = true;
    }

    if (dirty || burning > 0) { updateColors(time); if (dirty) updateHoverLabel(); dirty = false; }

    const level = flood * LMAX;
    updateHouses(level);
    water.visible = level > 0.01;
    water.position.y = level;

    smoothAir += (airLevel - smoothAir) * Math.min(1, dt * 6);
    const smokeAmt = Math.max(0, Math.min(0.92, (smoothAir - 28) / 240));
    const camDist = camera.position.distanceTo(controls.target);
    sky.copy(SKY_CLEAR).lerp(SKY_RAIN, rainF * 0.7).lerp(SKY_SMOKE, smokeAmt);
    scene.fog.color.copy(sky);
    scene.fog.near = THREE.MathUtils.lerp(72, Math.max(1, camDist * 0.12), smokeAmt);
    scene.fog.far = THREE.MathUtils.lerp(200, camDist * 1.35 + 14, smokeAmt);
    const skyHex = '#' + sky.getHexString();
    if (skyHex !== lastSkyHex) { lastSkyHex = skyHex; simRoot.style.backgroundColor = skyHex; }
    const dim = Math.max(rainF * 0.6, smokeAmt);
    sun.intensity = 1.15 - 0.55 * dim;
    hemi.intensity = 0.95 - 0.25 * dim;

    controls.update();
    renderer.render(scene, camera);
  }

  for (let i = 0; i < N; i++) refreshCellTrees(i);
  const tickTimer = setInterval(tick, 200);
  animate();

  window.addEventListener('pagehide', () => {
    cancelAnimationFrame(rafId);
    clearInterval(tickTimer);
    window.removeEventListener('resize', onResize);
    controls.dispose();
    renderer.dispose();
  });
}
</script>

