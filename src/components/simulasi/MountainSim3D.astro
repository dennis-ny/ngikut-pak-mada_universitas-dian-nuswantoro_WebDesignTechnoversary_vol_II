<section class="mountain-sim-wrap" id="mountain-sim-wrap" data-nav-theme="rain">
  <div id="app"></div>

  <div id="tools">
    <button class="on" id="t-fire" type="button">Api</button>
    <button id="t-saw" type="button">Tebang</button>
    <button id="t-plant" type="button">Tanam</button>
    <button id="rain" type="button">Hujan</button>
    <button id="reset" type="button">Reset</button>
  </div>

  <div id="panel">
    <div class="card m" title="Kualitas udara"><span class="ic">💨</span><div class="l">Kualitas udara</div><span class="pill air-pill" id="cat">Baik</span></div>
    <div class="card m" title="Tutupan hutan"><span class="ic">🌲</span><div class="l">Tutupan hutan</div><div class="v" id="cover">100%</div></div>
    <div class="card m" title="Pemukiman terdampak banjir"><span class="ic">🏠</span><div class="l">Pemukiman terdampak banjir</div><div class="v" id="hs">0 / 8</div></div>
    <div class="card m" title="Satwa hidup"><span class="ic">🐒</span><div class="l">Satwa hidup</div><div class="v" id="wild">26 / 26</div></div>
  </div>

  <div id="hover" class="card"></div>
  <div id="help">Drag: putar<span class="sep">&middot;</span>Scroll: zoom<span class="sep">&middot;</span>Klik area: interaksi</div>
  <div id="legend" class="card">
    <span><i style="background:#5b8c3a"></i>sehat</span>
    <span><i style="background:#e0561c"></i>terbakar</span>
    <span><i style="background:#2d2a27"></i>hangus</span>
    <span><i style="background:#9c6b36"></i>gundul</span>
    <span><i style="background:#93b958"></i>pulih</span>
    <span><i style="background:#6b4a2b"></i>longsor</span>
    <span><i style="background:linear-gradient(180deg,#d63a2c 0 50%,#f5f5f5 50% 100%)"></i>rumah tertinggi</span>
  </div>
  <div id="msg" class="card">Pilih alat, lalu klik area di gunung.</div>
</section>

<script>
// @ts-nocheck
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
import { mergeGeometries } from 'three/examples/jsm/utils/BufferGeometryUtils.js';

const simRoot = document.getElementById('mountain-sim-wrap');
const app = document.getElementById('app');

if (simRoot && app) {
  /* ====================== KONFIGURASI ====================== */
  const S = 2.3;          // skala lebar gunung
  const HS = 2.5;         // skala tinggi gunung
  const R0 = 5;           // radius gunung dasar (sebelum skala)
  const R = R0 * S;       // radius gunung
  const H = 3.3 * HS;     // tinggi puncak
  const LR = 20;          // radius dataran (desa)
  const B = 0.45;         // ketinggian kaki gunung (di atas lahan pemukiman)
  const NR = 6;           // jumlah cincin (puncak -> kaki)
  const NS = 16;          // jumlah sektor per cincin
  const N = NR * NS;      // total area
  const SR = 4, SA = 4;   // subdivisi per area (kehalusan mesh)
  const NJ = NR * SR, NK = NS * SA;
  const BURN_MS = 6000;   // lama api menyala
  const FIRE_SPREAD_CHANCE = 0.018; // peluang api merembet ke tetangga per tick
  const FIRE_MAX_HOPS = 2;          // maksimal jarak rembetan dari 1 titik bakar (2 = maks radius 2 petak)
  const RAIN_MS = 10000;  // durasi hujan
  const FLOOD_DELAY_MS = 4000; // hujan dulu sekian milidetik sebelum banjir mulai naik (hujan total 10 detik)
  const SMOKE_CLEAR_MIN_MS = 4000;  // durasi minimum pemulihan asap ringan
  const SMOKE_CLEAR_MAX_MS = 18000; // durasi maksimum pemulihan asap parah
  const RAIN_WASH_MULT = 2.6;       // percepatan hilangnya asap saat hujan turun

  /* ====================== STATE SIMULASI ====================== */
  /* st: h=sehat, b=terbakar, x=hangus, g=gundul, r=pulih */
  const cells = [];
  let tool = 'fire', rainUntil = 0, rainStart = 0, wasRain = false;
  let flood = 0, airLevel = 25, smoothAir = 25, prevBurn = 0, hover = -1, dirty = true, rainF = 0;
  let smokeClearElapsed = 0, smokeClearFrom = 25, smokeClearDur = SMOKE_CLEAR_MIN_MS, lastAirTick = 0;

  function initCells() {
    cells.length = 0;
    for (let i = 0; i < N; i++) cells.push({ st: 'h', t: 0, hop: 0, slide: false, vis: '' });
  }
  initCells();

  /* ====================== SCENE ====================== */
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  app.appendChild(renderer.domElement);

  const SKY_CLEAR = new THREE.Color(0x6ebce8);
  const SKY_RAIN = new THREE.Color(0x6f7f8c);
  const SKY_SMOKE = new THREE.Color(0x6c584c);
  const sky = SKY_CLEAR.clone();

  const scene = new THREE.Scene();
  scene.background = sky;
  scene.fog = new THREE.Fog(sky, 72, 200);

  const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 300);
  camera.position.set(25, 20, 25);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.target.set(0, 2.8, 0);
  controls.enableDamping = true;
  controls.enablePan = false;
  controls.minDistance = 15;
  controls.maxDistance = 70;
  controls.maxPolarAngle = 1.45;
  controls.update();

  const hemi = new THREE.HemisphereLight(0xffffff, 0x6b5a3a, 0.95);
  scene.add(hemi);
  const sun = new THREE.DirectionalLight(0xffffff, 1.15);
  sun.position.set(6, 10, 4);
  scene.add(sun);

  /* ====================== TERRAIN ====================== */
  const PEAKS = [
    { x: -1.3, z: 0.4,  h: 3.7, rad: 3.0 },   // puncak utama
    { x: 1.7,  z: -1.0, h: 2.9, rad: 2.4 }    // puncak kedua
  ];
  const DOMES = [
    { x: -0.4, z: 2.3, r: 1.5, h: 1.75 },     // setengah bola depan
    { x: -1.5, z: -2.3, r: 1.5, h: 1.75 }     // setengah bola belakang
  ];
  const RIDGE = { x1: 2.0, z1: 0.8, x2: 2.5, z2: 2.1, r: 1.0, h: 1.35 };    // setengah tabung

  function segDist(px, pz, x1, z1, x2, z2) {
    const dx = x2 - x1, dz = z2 - z1;
    const t = Math.max(0, Math.min(1, ((px - x1) * dx + (pz - z1) * dz) / (dx * dx + dz * dz)));
    return Math.hypot(px - (x1 + t * dx), pz - (z1 + t * dz));
  }

  function hgt(x, z) { return B + HS * hgt0(x / S, z / S); }
  function hgt0(x, z) {
    const r = Math.hypot(x, z);
    let base = 0;
    for (const p of PEAKS) {
      const d = Math.hypot(x - p.x, z - p.z);
      base += p.h * Math.pow(Math.max(0, 1 - d / p.rad), 1.5);
    }
    let dome = 0;
    for (const D of DOMES) { const dd = Math.hypot(x - D.x, z - D.z) / D.r; dome = Math.max(dome, D.h * Math.sqrt(Math.max(0, 1 - dd * dd))); }
    const rd = segDist(x, z, RIDGE.x1, RIDGE.z1, RIDGE.x2, RIDGE.z2) / RIDGE.r;
    const ridge = RIDGE.h * Math.sqrt(Math.max(0, 1 - rd * rd));

    const h = Math.max(base, dome, ridge);
    const tt = Math.max(0, Math.min(1, (R0 - r) / (R0 * 0.35)));
    const f = tt * tt * (3 - 2 * tt);
    const n = (Math.sin(x * 1.3 + 0.7) * Math.cos(z * 1.1) * 0.12 + Math.sin(x * 2.7 + z * 1.9) * 0.07) * Math.min(1, h * 1.5);
    return Math.max(0, (h + n) * f);
  }
  function hash2(x, y) { let h = Math.imul(x, 374761393) ^ Math.imul(y, 668265263); h = Math.imul(h ^ (h >>> 13), 1274126177); h ^= h >>> 16; return (h >>> 0) / 4294967296; }
  function vnoise(x, y) {
    const ix = Math.floor(x), iy = Math.floor(y), fx = x - ix, fy = y - iy, u = fx * fx * (3 - 2 * fx), v = fy * fy * (3 - 2 * fy);
    const a = hash2(ix, iy), b = hash2(ix + 1, iy), c = hash2(ix, iy + 1), d = hash2(ix + 1, iy + 1);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }

  const NC = 8;
  const HOUSE_K = 1.5;
  const PAD_FLAT = 2.7, PAD_EDGE = 0.8;
  const PADS = [];
  {
    const order = [3, 0, 6, 2, 7, 4, 1, 5, 8, 9, 10, 11].slice(0, NC);
    const ranked = order.slice().sort((p, q) => p - q);
    for (let c = 0; c < NC; c++) {
      const an = (c + 0.5) / NC * Math.PI * 2 + Math.sin(c * 2.3) * 0.08, r = R + (LR - R) * 0.5 + Math.cos(c * 1.7) * 0.15;
      const rank = ranked.indexOf(order[c]);
      PADS.push({ x: r * Math.cos(an), z: r * Math.sin(an), y: 0.06 + 0.24 * rank / (NC - 1) });
    }
  }
  function plainH(x, z) {
    const r = Math.hypot(x, z);
    if (r <= R) return B;
    const q = Math.min(1, (r - R) / 1.2), s = q * q * (3 - 2 * q);
    const n = vnoise(x * 0.62 + 3.1, z * 0.62 - 1.7) * 0.7 + vnoise(x * 1.35 - 8.4, z * 1.35 + 5.2) * 0.3;
    const hills = Math.max(0, n - 0.30) * 1.15;
    let h = B * (1 - s) + s * (0.03 + hills);
    for (const pd of PADS) {
      const d = Math.hypot(x - pd.x, z - pd.z);
      if (d < PAD_FLAT + PAD_EDGE) { const t = Math.min(1, (PAD_FLAT + PAD_EDGE - d) / PAD_EDGE), w = t * t * (3 - 2 * t); h += (pd.y - h) * w; }
    }
    const q2 = Math.min(1, Math.max(0, (r - (LR - 1.4)) / 1.4)), w2 = q2 * q2 * (3 - 2 * q2), RIM = 0.58;
    if (h < RIM) h += (RIM - h) * w2;
    return h;
  }
  function ground(x, z) { return Math.hypot(x, z) <= R ? meshY(x, z) : plainH(x, z); }
  function meshY(x, z) {
    const r = Math.hypot(x, z);
    if (r >= R) return hgt(x, z);
    let a = Math.atan2(z, x); if (a < 0) a += Math.PI * 2;
    const jf = r / R * NJ, kf = a / (Math.PI * 2) * NK;
    if (jf < SR) {
      const k0 = Math.min(NK - 8, Math.floor(kf / 8) * 8);
      const tris = innerWedgeTris[k0 >> 3];
      for (let t = 0; t < tris.length; t++) {
        const [j0, kA, j1, kB, j2, kC] = tris[t];
        const r0 = R * j0 / NJ, x0 = r0 * COSA[kA], z0 = r0 * SINA[kA];
        const r1 = R * j1 / NJ, x1 = r1 * COSA[kB], z1 = r1 * SINA[kB];
        const r2 = R * j2 / NJ, x2 = r2 * COSA[kC], z2 = r2 * SINA[kC];
        const d = (z1 - z2) * (x0 - x2) + (x2 - x1) * (z0 - z2);
        if (Math.abs(d) < 1e-8) continue;
        const w0 = ((z1 - z2) * (x - x2) + (x2 - x1) * (z - z2)) / d;
        const w1 = ((z2 - z0) * (x - x2) + (x0 - x2) * (z - z2)) / d;
        const w2 = 1 - w0 - w1;
        if (w0 >= -1e-4 && w1 >= -1e-4 && w2 >= -1e-4) {
          return w0 * vy(j0, kA) + w1 * vy(j1, kB) + w2 * vy(j2, kC);
        }
      }
    }
    const j = Math.min(NJ - 1, Math.floor(jf)), k0 = Math.floor(kf), k = k0 % NK, v = jf - j, u = kf - k0;
    const ya = vy(j, k), yc = vy(j + 1, k + 1);
    if (v > u) { const yb = vy(j + 1, k); return ya + (yb - ya) * (v - u) + (yc - ya) * u; }
    const yd = vy(j, k + 1); return ya + (yd - ya) * (u - v) + (yc - ya) * v;
  }

  function P(j, k) {
    const r = R * j / NJ, a = k * Math.PI * 2 / NK;
    const x = r * Math.cos(a), z = r * Math.sin(a);
    return [x, hgt(x, z), z];
  }

  const VY0 = new Float32Array((NJ + 1) * NK), VY = new Float32Array((NJ + 1) * NK);
  for (let j = 0; j <= NJ; j++) for (let k = 0; k < NK; k++) VY0[j * NK + k] = P(j, k)[1];
  VY.set(VY0);
  function vy(j, k) { return VY[j * NK + (k % NK)]; }
  const COSA = [], SINA = [];
  for (let k = 0; k <= NK; k++) { COSA.push(Math.cos(k * Math.PI * 2 / NK)); SINA.push(Math.sin(k * Math.PI * 2 / NK)); }

  const triVerts = [], faceCell = [], faceShade = [], innerWedgeTris = [];
  {
    const addTri = (j0, k0, j1, k1, j2, k2, cid, shade) => {
      triVerts.push(j0, k0, j1, k1, j2, k2);
      faceCell.push(cid);
      faceShade.push(shade);
    };
    for (let k0 = 0; k0 < NK; k0 += 8) {
      const cA = Math.floor(k0 / SA), cB = cA + 1;
      const wTris = [];
      const pushW = (j0, kA, j1, kB, j2, kC, cid, shade) => {
        addTri(j0, kA, j1, kB, j2, kC, cid, shade);
        wTris.push([j0, kA, j1, kB, j2, kC]);
      };
      pushW(0, 0, 2, k0 + 8, 2, k0, cA, 0.97 + Math.random() * 0.05);
      for (let m = 0; m < 4; m++) pushW(2, k0, 4, k0 + m + 1, 4, k0 + m, cA, 0.95 + Math.random() * 0.08);
      pushW(2, k0, 2, k0 + 8, 4, k0 + 4, cA, 0.95 + Math.random() * 0.08);
      for (let m = 4; m < 8; m++) pushW(2, k0 + 8, 4, k0 + m + 1, 4, k0 + m, cB, 0.95 + Math.random() * 0.08);
      innerWedgeTris.push(wTris);
    }
    for (let j = SR; j < NJ; j++) {
      for (let k = 0; k < NK; k++) {
        const cid = Math.floor(j / SR) * NS + Math.floor(k / SA);
        addTri(j, k, j + 1, k + 1, j + 1, k, cid, 0.93 + Math.random() * 0.14);
        addTri(j, k, j, k + 1, j + 1, k + 1, cid, 0.93 + Math.random() * 0.14);
      }
    }
  }
  function fillTerrainPos(arr) {
    let o = 0;
    for (let t = 0; t < triVerts.length; t += 2) {
      const j = triVerts[t], k = triVerts[t + 1];
      const r = R * j / NJ;
      arr[o++] = r * COSA[k];
      arr[o++] = vy(j, k);
      arr[o++] = r * SINA[k];
    }
  }
  const posBuf = new Float32Array(faceCell.length * 9);
  fillTerrainPos(posBuf);
  const terrainGeo = new THREE.BufferGeometry();
  const posAttr = new THREE.BufferAttribute(posBuf, 3);
  terrainGeo.setAttribute('position', posAttr);
  const colorAttr = new THREE.BufferAttribute(new Float32Array(posBuf.length), 3);
  terrainGeo.setAttribute('color', colorAttr);
  const mountain = new THREE.Mesh(
    terrainGeo,
    new THREE.MeshStandardMaterial({ vertexColors: true, flatShading: true, side: THREE.DoubleSide })
  );

  const slideAnims = [];
  const ERODE = 0.65;
  const DEPOSIT = 0.4;
  const SLIDE_DUR = 1.4;
  const SLIDE_MUD = 18;
  const SLIDE_DUST = 5;
  const SLIDE_DELAY_MS = 5000;
  const bump = (i, n) => Math.max(0, Math.cos(Math.PI * (i - n / 2) / (n + 2)));
  function startSlide(i) {
    const c = cells[i];
    if (c.eroded) return;
    c.eroded = true; slideAnims.push({ i, p: 0 });
    for (let k = 0; k < SLIDE_MUD; k++) {
      const p = randPoint(i), m = mud.ptr;
      spawn(mud, p.x, p.y + 0.1, p.z, 0, 0, 0, 3.5);
      mudVel[m] = 0.9 + Math.random() * 1.4;
    }
    for (let k = 0; k < SLIDE_DUST; k++) {
      const p = randPoint(i);
      spawn(smoke, p.x, p.y + 0.2, p.z, (Math.random() - 0.5) * 0.8, 0.5 + Math.random() * 0.6, (Math.random() - 0.5) * 0.8, 1.5 + Math.random());
    }
  }
  function shiftCell(i, amount) {
    const ring = Math.floor(i / NS), sec = i % NS;
    for (let jj = 0; jj <= SR; jj++) for (let kk = 0; kk <= SA; kk++) {
      const idx = (ring * SR + jj) * NK + ((sec * SA + kk) % NK);
      VY[idx] = Math.max(B, VY[idx] + amount * bump(jj, SR) * bump(kk, SA));
    }
  }
  function stepSlides(dt) {
    if (!slideAnims.length) return;
    const ease = t => t * t * (3 - 2 * t);
    const touchedCells = new Set();
    for (let n = slideAnims.length - 1; n >= 0; n--) {
      const a = slideAnims[n], np = Math.min(1, a.p + dt / SLIDE_DUR), d = ease(np) - ease(a.p);
      const ring = Math.floor(a.i / NS), sec = a.i % NS;
      shiftCell(a.i, -ERODE * d);
      if (ring + 1 < NR) shiftCell(a.i + NS, DEPOSIT * d);
      if (a.p < 0.3 && np >= 0.3) cells[a.i].gone = true;
      a.p = np;
      for (let dr = -1; dr <= 1; dr++) for (let ds = -1; ds <= 1; ds++) {
        const rr = ring + dr; if (rr < 0 || rr >= NR) continue;
        touchedCells.add(rr * NS + (sec + ds + NS) % NS);
      }
      if (np >= 1) slideAnims.splice(n, 1);
    }
    touchedCells.forEach(cid => refreshCellTreePos(cid));
    foliage.instanceMatrix.needsUpdate = true;
    trunk.instanceMatrix.needsUpdate = true;
    fillTerrainPos(posBuf); posAttr.needsUpdate = true;
    if (!slideAnims.length) terrainGeo.computeBoundingSphere();
  }
  function resetTerrain() {
    slideAnims.length = 0; VY.set(VY0); fillTerrainPos(posBuf); posAttr.needsUpdate = true; terrainGeo.computeBoundingSphere();
  }
  scene.add(mountain);

  /* dataran + desa (berkontur) */
  const villageHouses = []; let LMAX = 0.5, topIdx = 0;
  {
    const NPJ = 40, NPK = 180, pp = [], pc = [], pi = [], c = new THREE.Color();
    for (let j = 0; j <= NPJ; j++) for (let k = 0; k < NPK; k++) {
      const RI = R - 0.6, r = RI + (LR - RI) * j / NPJ, a = k * Math.PI * 2 / NPK, x = r * Math.cos(a), z = r * Math.sin(a), h = plainH(x, z);
      pp.push(x, r <= R ? B - 0.03 : h, z);
      c.setRGB(0.27, 0.45, 0.19).lerp(new THREE.Color(0.55, 0.61, 0.30), Math.min(1, h / 0.6)).multiplyScalar(0.95 + Math.random() * 0.1);
      pc.push(c.r, c.g, c.b);
    }
    for (let j = 0; j < NPJ; j++) for (let k = 0; k < NPK; k++) {
      const a = j * NPK + k, b = j * NPK + (k + 1) % NPK, d = (j + 1) * NPK + k, e = (j + 1) * NPK + (k + 1) % NPK;
      pi.push(a, b, d, b, e, d);
    }
    const pg = new THREE.BufferGeometry();
    pg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(pp), 3));
    pg.setAttribute('color', new THREE.BufferAttribute(new Float32Array(pc), 3));
    pg.setIndex(pi); pg.computeVertexNormals();
    scene.add(new THREE.Mesh(pg, new THREE.MeshStandardMaterial({ vertexColors: true, flatShading: true, roughness: 1 })));

    const SEG = NPK, wp = [], wc = [], wi = [];
    for (let k = 0; k < SEG; k++) {
      const a = k / SEG * Math.PI * 2, x = LR * Math.cos(a), z = LR * Math.sin(a), y = plainH(x, z);
      wp.push(x, y, z, x, y - 0.08, z, x, -0.6, z);
      wc.push(0.43, 0.56, 0.25, 0.42, 0.29, 0.17, 0.25, 0.17, 0.1);
    }
    for (let k = 0; k < SEG; k++) for (let row = 0; row < 2; row++) {
      const a = k * 3 + row, b = ((k + 1) % SEG) * 3 + row; wi.push(a, b, a + 1, b, b + 1, a + 1);
    }
    const wg = new THREE.BufferGeometry();
    wg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(wp), 3));
    wg.setAttribute('color', new THREE.BufferAttribute(new Float32Array(wc), 3));
    wg.setIndex(wi); wg.computeVertexNormals();
    scene.add(new THREE.Mesh(wg, new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 1, side: THREE.DoubleSide })));

    const bodyGeo = new THREE.BoxGeometry(0.4, 0.3, 0.4), roofGeo = new THREE.ConeGeometry(0.34, 0.25, 4);
    const houseMats = {
      body: new THREE.MeshStandardMaterial({ color: 0xfaf5eb, flatShading: true }),
      roof: new THREE.MeshStandardMaterial({ color: 0xb5523b, flatShading: true })
    };
    let sd = 7; const rnd = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
    const picked = [], farEnough = (x, z) => picked.every(p => Math.hypot(p.x - x, p.z - z) > 1.0);
    PADS.forEach((pd, c) => {
      const want = 11 + Math.floor(rnd() * 3);
      let got = 0;
      for (let t = 0; t < 2000 && got < want; t++) {
        const a2 = rnd() * 6.283, d = Math.sqrt(rnd()) * (PAD_FLAT - 0.3), x = pd.x + d * Math.cos(a2), z = pd.z + d * Math.sin(a2);
        if (farEnough(x, z)) { picked.push({ x, z, y: plainH(x, z), c }); got++; }
      }
    });
    const houseBodies = new THREE.InstancedMesh(bodyGeo, houseMats.body, picked.length);
    const houseRoofs = new THREE.InstancedMesh(roofGeo, houseMats.roof, picked.length);
    const hDummy = new THREE.Object3D();
    picked.forEach(({ x, z, y, c }, idx) => {
      const ry = rnd() * Math.PI / 2;
      const K = HOUSE_K;
      hDummy.scale.setScalar(K);
      hDummy.position.set(x, y - 0.05 + 0.15 * K, z);
      hDummy.rotation.set(0, ry, 0);
      hDummy.updateMatrix();
