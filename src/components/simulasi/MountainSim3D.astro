  function stepPool(p, dt, colorFn) {
    if (p.active <= 0) return;
    let alive = 0;
    for (let i = 0; i < p.n; i++) {
      if (p.life[i] <= 0) continue;
      p.life[i] -= dt;
      if (p.life[i] <= 0) {
        p.pos[i * 3 + 1] = -100;
        p.col[i * 3] = p.col[i * 3 + 1] = p.col[i * 3 + 2] = 0;
        continue;
      }
      alive++;
      p.pos[i * 3] += p.vx[i] * dt;
      p.pos[i * 3 + 1] += p.vy[i] * dt;
      p.pos[i * 3 + 2] += p.vz[i] * dt;
      colorFn(p.life[i] / p.max[i], i, p.col);
    }
    p.active = alive;
    p.pts.visible = alive > 0;
    p.geo.attributes.position.needsUpdate = true;
    p.geo.attributes.color.needsUpdate = true;
  }
