    else if (a <= 150) { t = 'Kurang baik'; bg = 'rgba(242, 169, 59, 0.22)'; fg = '#f2a93b'; }
    else if (a <= 200) { t = 'Buruk'; bg = 'rgba(224, 86, 28, 0.24)'; fg = '#ff7b47'; }
    else if (a <= 300) { t = 'Sangat buruk'; bg = 'rgba(224, 86, 28, 0.28)'; fg = '#ff7b47'; }
