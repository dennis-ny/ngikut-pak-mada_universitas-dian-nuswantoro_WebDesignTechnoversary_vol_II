---
import { siteContent } from "../../data/content";
---

<footer class="ashen-footer">
  <div class="container footer-grid">
    <div class="footer-brand-col">
      <div class="footer-badge font-mono">{siteContent.competitionBadge}</div>
      <h2 class="footer-logo">{siteContent.brand}</h2>
      <p class="footer-statement">{siteContent.footer.statement}</p>
      <p class="footer-location font-mono">{siteContent.footer.locationNote}</p>
    </div>

    <div class="footer-nav-col">
      <div class="footer-col-label font-mono">{siteContent.footer.quickLinksTitle}</div>
      <ul class="footer-links">
        {siteContent.navItems.map((item) => (
          <li>
            <a href={item.href} class="footer-big-link">
              <span>{item.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-action-col">
      <div class="footer-col-label font-mono">{siteContent.footer.actionTitle}</div>
      <p class="footer-action-sub">{siteContent.footer.actionSubtitle}</p>
      <a href={siteContent.ctaSimulasi.href} class="btn-pill btn-pill--leaf footer-cta">
        <span>Buka Simulasi 3D</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>{siteContent.footer.copyright}</span>
    <span class="font-mono">{siteContent.footer.institutionNote}</span>
  </div>
</footer>

<style>
  .ashen-footer {
    background-color: var(--color-charcoal-deep);
    color: var(--color-cream);
    padding: 76px 0 36px;
    border-top: 1px solid rgba(252, 246, 236, 0.1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(252, 246, 236, 0.1);
  }

  .footer-badge {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-leaf-accent);
    margin-bottom: 12px;
  }

  .footer-logo {
    font-family: var(--font-sans);
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.06em;
    margin-bottom: 20px;
  }

  .footer-statement {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(252, 246, 236, 0.78);
    max-width: 440px;
    margin-bottom: 20px;
  }

  .footer-location {
    font-size: 12px;
    color: rgba(252, 246, 236, 0.5);
  }

  .footer-col-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(252, 246, 236, 0.5);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-big-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    padding: 6px 0;
    color: var(--color-cream);
    transition: opacity 0.2s ease;
  }

  .footer-big-link:hover {
    opacity: 0.5;
  }

  .footer-action-sub {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(252, 246, 236, 0.78);
    margin-bottom: 24px;
  }

  .footer-cta {
    width: 100%;
    max-width: 280px;
  }

  .footer-bottom {
    padding-top: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: rgba(252, 246, 236, 0.55);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
