---
import { homeContent } from "../../data/content";

const { inspired } = homeContent;
---

<section class="inspired-section" data-nav-theme="light">
  <div class="container inspired-editorial-grid">
    <div class="inspired-left" data-reveal>
      <span class="eyebrow inspired-eyebrow">{inspired.eyebrow}</span>

      <h2 class="inspired-overlap-title font-display">
        <span class="title-line">{inspired.headlineLines[0]}</span>
        <span class="title-line title-line--accent">{inspired.headlineLines[1]}</span>
      </h2>

      <div class="inspired-actions">
        <a href={inspired.cta.href} class="btn-pill btn-pill--forest">
          <span>{inspired.cta.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href={inspired.secondaryCta.href} class="btn-outline-dark">
          <span>{inspired.secondaryCta.label}</span>
        </a>
      </div>
    </div>

    <div class="inspired-right" data-reveal>
      <div class="inspired-photo-frame parallax-window">
        <img
          src={inspired.image}
          alt="Cahaya Matahari Menembus Hutan Hijau"
          class="inspired-photo parallax-media"
          data-parallax="0.22"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="container inspired-bottom-center" data-reveal>
    <p class="inspired-body">{inspired.body}</p>
  </div>
</section>

<style>
  .inspired-section {
    background-color: var(--color-neutral-1);
    color: var(--color-charcoal);
    padding: clamp(84px, 12vh, 148px) 0;
    border-top: 1px solid rgba(46, 37, 33, 0.08);
    overflow: hidden;
  }

  .inspired-editorial-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    position: relative;
  }

  .inspired-left {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .inspired-eyebrow {
    color: #2f6b3c;
    margin-bottom: 16px;
  }

  /* Clean 2-line punchy display on bright canvas */
  .inspired-overlap-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(68px, 9.5vw, 136px);
    font-weight: 700;
    line-height: 0.88;
    color: var(--color-charcoal);
    margin-bottom: 32px;
  }

  .title-line {
    display: block;
  }

  .title-line--accent {
    color: #2f6b3c;
  }

  .inspired-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .btn-pill--forest {
    background-color: var(--color-forest-deep);
    color: var(--color-cream);
  }

  .btn-outline-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: var(--radius-none);
    border: 1.5px solid rgba(46, 37, 33, 0.35);
    background: transparent;
    color: var(--color-charcoal);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .btn-outline-dark:hover {
    border-color: var(--color-charcoal);
    background-color: rgba(46, 37, 33, 0.06);
  }

  /* Wide Right Image Container with Windowed Parallax */
  .inspired-right {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .inspired-photo-frame {
    position: relative;
    width: 100%;
    height: clamp(460px, 68vh, 660px);
    border-radius: 16px;
    overflow: hidden;
  }

  .inspired-photo {
    width: 100%;
    height: 128%;
    object-fit: cover;
    object-position: center;
    position: absolute;
    top: -14%;
    left: 0;
  }

  /* Bottom Centered Paragraph */
  .inspired-bottom-center {
    margin-top: clamp(56px, 8vh, 88px);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .inspired-body {
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.55;
    color: rgba(46, 37, 33, 0.82);
    max-width: 680px;
  }

  @media (max-width: 960px) {
    .inspired-editorial-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .inspired-overlap-title {
      width: 100%;
    }
    .inspired-photo-frame {
      height: clamp(340px, 50vh, 460px);
    }
  }
</style>
