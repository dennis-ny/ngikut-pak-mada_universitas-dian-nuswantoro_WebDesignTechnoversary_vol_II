---
import { homeContent } from "../../data/content";

const { beforeAfter } = homeContent;
---

<section class="before-after-section">
    <div class="ba-sticky">
        <div class="container">
            <div class="ba-header-bar" data-reveal>
                <span class="eyebrow ba-eyebrow font-mono">
                    KOMPARASI EKOSISTEM
                </span>
                <h2 class="ba-title font-display">{beforeAfter.headline}</h2>
                <span class="ba-hint font-mono">GESER KIRI & KANAN</span>
            </div>

            <div class="ba-stage" id="ba-stage" data-reveal>
                <div class="ba-layer ba-layer--healthy">
                    <img
                        src={beforeAfter.healthy.image}
                        alt={beforeAfter.healthy.label}
                        class="ba-bg-img"
                        decoding="async"
                    />
                    <div class="ba-shade"></div>

                    <div class="ba-corner ba-corner--right">
                        <span class="ba-label">
                            {beforeAfter.healthy.label}
                        </span>
                        <div class="ba-metric font-display">
                            {beforeAfter.healthy.metricBig}
                        </div>
                    </div>
                </div>

                <div class="ba-layer ba-layer--burned" id="ba-burned-layer">
                    <img
                        src={beforeAfter.burned.image}
                        alt={beforeAfter.burned.label}
                        class="ba-bg-img"
                        decoding="async"
                    />
                    <div class="ba-shade"></div>

                    <div class="ba-corner ba-corner--left">
                        <span class="ba-label">{beforeAfter.burned.label}</span>
                        <div class="ba-metric font-display">
                            {beforeAfter.burned.metricBig}
                        </div>
                    </div>
                </div>

                <div class="ba-divider" id="ba-divider">
                    <div class="ba-dashed-line"></div>
                    <button
                        type="button"
                        class="ba-handle"
                        id="ba-handle"
                        role="slider"
                        aria-valuemin="5"
                        aria-valuemax="95"
                        aria-valuenow="50"
                        aria-label="Geser kotak tengah ini untuk membandingkan hutan terbakar dan hutan sehat"
                    >
                        <svg
                            width="16"
                            height="10"
                            viewBox="0 0 16 10"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                        >
                            <path
                                d="M5.5 1.5L1.5 5L5.5 8.5"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                            <path
                                d="M10.5 1.5L14.5 5L10.5 8.5"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const stage = document.getElementById("ba-stage");
    const handle = document.getElementById("ba-handle") as HTMLButtonElement | null;
    const burnedLayer = document.getElementById("ba-burned-layer");
    const divider = document.getElementById("ba-divider");

    const clamp = (v: number, min = 5, max = 95) =>
        Math.max(min, Math.min(max, v));
    let targetVal = 50;
    let currentVal = targetVal;
    let rafRunning = false;

    function applySplit(val: number) {
        if (!burnedLayer || !divider || !stage) return;
        const xPx = (val / 100) * stage.clientWidth;
        burnedLayer.style.clipPath = `inset(0 ${(100 - val).toFixed(3)}% 0 0)`;
        divider.style.transform = `translate3d(${xPx.toFixed(2)}px, 0, 0)`;
    }

    function stepSplit() {
        currentVal += (targetVal - currentVal) * 0.28;
        if (Math.abs(targetVal - currentVal) < 0.02) {
            currentVal = targetVal;
            applySplit(currentVal);
            rafRunning = false;
            return;
        }
        applySplit(currentVal);
        requestAnimationFrame(stepSplit);
    }

    function setTarget(val: number) {
        targetVal = clamp(val);
        if (handle) handle.setAttribute("aria-valuenow", String(Math.round(targetVal)));
        if (!rafRunning) {
            rafRunning = true;
            requestAnimationFrame(stepSplit);
        }
    }

    if (stage && handle) {
        let dragging = false;
        let activePointerId: number | null = null;

        const valFromPointer = (clientX: number) => {
            const rect = stage.getBoundingClientRect();
            return ((clientX - rect.left) / Math.max(1, rect.width)) * 100;
        };

        // Drag via handle (touch & mouse)
        handle.addEventListener("pointerdown", (e) => {
            e.stopPropagation();
            dragging = true;
            activePointerId = e.pointerId;
            handle.setPointerCapture(e.pointerId);
            handle.classList.add("is-dragging");
        });

        handle.addEventListener("pointermove", (e) => {
            if (!dragging || e.pointerId !== activePointerId) return;
            setTarget(valFromPointer(e.clientX));
        });

        const endHandleDrag = (e: PointerEvent) => {
            if (!dragging || e.pointerId !== activePointerId) return;
            dragging = false;
            activePointerId = null;
            handle.classList.remove("is-dragging");
            if (handle.hasPointerCapture(e.pointerId)) {
                handle.releasePointerCapture(e.pointerId);
            }
        };
        handle.addEventListener("pointerup", endHandleDrag);
        handle.addEventListener("pointercancel", endHandleDrag);

        // Mouse drag on stage (touch ignored so vertical scroll still works)
        stage.addEventListener("pointerdown", (e) => {
            if (e.pointerType !== "mouse") return;
            dragging = true;
            activePointerId = e.pointerId;
            stage.setPointerCapture(e.pointerId);
            handle.classList.add("is-dragging");
            setTarget(valFromPointer(e.clientX));
        });

        stage.addEventListener("pointermove", (e) => {
            if (!dragging || e.pointerType !== "mouse" || e.pointerId !== activePointerId) return;
            setTarget(valFromPointer(e.clientX));
        });

        const endStageDrag = (e: PointerEvent) => {
            if (!dragging || e.pointerType !== "mouse" || e.pointerId !== activePointerId) return;
            dragging = false;
            activePointerId = null;
            handle.classList.remove("is-dragging");
            if (stage.hasPointerCapture(e.pointerId)) {
                stage.releasePointerCapture(e.pointerId);
            }
        };
        stage.addEventListener("pointerup", endStageDrag);
        stage.addEventListener("pointercancel", endStageDrag);

        handle.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") {
                e.preventDefault();
                setTarget(targetVal - 5);
            } else if (e.key === "ArrowRight") {
                e.preventDefault();
                setTarget(targetVal + 5);
            }
        });

        window.addEventListener("resize", () => applySplit(currentVal), {
            passive: true,
        });
        applySplit(currentVal);
    }
</script>

<style>
    .before-after-section {
        position: relative;
        z-index: 3;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: clamp(64px, 9vh, 108px) 0 clamp(76px, 10vh, 120px);
        background: linear-gradient(
            180deg,
            #14100d 0%,
            #181411 65%,
            #121110 100%
        );
        border-top: 1px solid rgba(252, 246, 236, 0.08);
        border-bottom: 1px solid rgba(252, 246, 236, 0.1);
        color: var(--color-cream);
        transform: translateZ(0);
    }

    .ba-sticky {
        width: 100%;
    }

    .ba-header-bar {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 24px;
        margin-bottom: 28px;
        border-bottom: 1px solid rgba(252, 246, 236, 0.12);
    }

    .ba-eyebrow {
        color: var(--color-ember);
        font-size: 12px;
    }

    .ba-title {
        font-size: clamp(36px, 4.6vw, 64px);
        color: var(--color-cream);
        letter-spacing: 0.01em;
    }

    .ba-hint {
        font-size: 11.5px;
        color: rgba(252, 246, 236, 0.58);
        letter-spacing: 0.08em;
    }

    .ba-stage {
        position: relative;
        width: 100%;
        height: clamp(440px, 66vh, 620px);
        border-radius: 16px;
        border: 1px solid rgba(252, 246, 236, 0.14);
        overflow: hidden;
        contain: layout paint;
        user-select: none;
        touch-action: pan-y;
        cursor: ew-resize;
    }

    @media (hover: none), (pointer: coarse) {
        .ba-stage {
            cursor: default;
        }
    }

    .ba-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .ba-layer--burned {
        clip-path: inset(0 50% 0 0);
        will-change: clip-path;
        z-index: 2;
    }

    .ba-layer--healthy {
        z-index: 1;
    }

    .ba-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .ba-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(18, 14, 12, 0.48) 0%,
            rgba(0, 0, 0, 0.05) 35%,
            rgba(0, 0, 0, 0.08) 70%,
            rgba(18, 14, 12, 0.45) 100%
        );
    }

    .ba-corner {
        position: absolute;
        top: clamp(28px, 4.5vh, 44px);
        z-index: 4;
        color: #ffffff;
    }

    .ba-corner--left {
        left: clamp(24px, 3vw, 40px);
        text-align: left;
    }

    .ba-corner--right {
        right: clamp(24px, 3vw, 40px);
        text-align: right;
    }

    .ba-label {
        display: block;
        font-family: var(--font-sans);
        font-size: clamp(13px, 1.15vw, 16px);
        font-weight: 400;
        line-height: 1.2;
        color: rgba(255, 255, 255, 0.95);
        margin-bottom: 4px;
    }

    .ba-metric {
        font-size: clamp(48px, 6vw, 88px);
        font-weight: 700;
        line-height: 0.88;
        color: #ffffff;
    }

    .ba-divider {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 0;
        z-index: 5;
        pointer-events: none;
        will-change: transform;
    }

    .ba-dashed-line {
        position: absolute;
        top: 24px;
        bottom: 24px;
        left: -1px;
        width: 0;
        border-left: 2px dashed rgba(255, 255, 255, 0.9);
    }

    .ba-handle {
        position: absolute;
        top: 50%;
        left: 0;
        transform: translate(-50%, -50%);
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background-color: #ffffff;
        color: #111111;
        border: none;
        display: grid;
        place-items: center;
        pointer-events: auto;
        touch-action: none;
        cursor: grab;
        transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
    }

    .ba-handle::before {
        content: "";
        position: absolute;
        inset: -14px;
    }

    .ba-handle.is-dragging {
        cursor: grabbing;
        transform: translate(-50%, -50%) scale(1.08);
    }

    @media (max-width: 1024px) {
        .before-after-section {
            padding: 64px 0 80px;
        }

        .ba-header-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
            padding-bottom: 20px;
            margin-bottom: 22px;
        }

        .ba-stage {
            height: clamp(400px, 56vh, 520px);
        }

        .ba-metric {
            font-size: clamp(44px, 7vw, 72px);
        }
    }

    @media (max-width: 640px) {
        .before-after-section {
            padding: 48px 0 60px;
        }

        .ba-header-bar {
            gap: 6px;
            padding-bottom: 16px;
            margin-bottom: 18px;
        }

        .ba-eyebrow {
            font-size: 11px;
        }

        .ba-title {
            font-size: clamp(32px, 9.5vw, 44px);
            line-height: 0.94;
        }

        .ba-hint {
            font-size: 10.5px;
        }

        .ba-stage {
            height: clamp(360px, 50svh, 430px);
            border-radius: 14px;
        }

        .ba-corner {
            top: 18px;
        }

        .ba-corner--left {
            left: 14px;
        }

        .ba-corner--right {
            right: 14px;
        }

        .ba-label {
            font-size: 11.5px;
            line-height: 1.25;
            margin-bottom: 4px;
        }

        .ba-metric {
            font-size: clamp(32px, 9.2vw, 44px);
        }

        .ba-dashed-line {
            top: 16px;
            bottom: 16px;
        }

        .ba-handle {
            width: 44px;
            height: 44px;
            border-radius: 12px;
        }
    }
</style>
