---
import { homeContent } from "../../data/content";

const { domino } = homeContent;
---

<section class="domino-horizontal-section" id="domino-horizontal-section" data-nav-theme="light">
  <div class="domino-sticky">
    <header class="domino-header-center">
      <h2 class="domino-giant-title font-display">
        <span class="title-top">{domino.titleTop}</span>
        <span class="title-bottom">{domino.titleBottom}</span>
      </h2>
      <p class="domino-intro-sub">{domino.subtitle}</p>
    </header>

    <div class="domino-track-wrap">
      <div class="domino-track" id="domino-track">
        {domino.cards.map((card) => (
          <article class="story-card">
            {card.image && (
              <div class="card-media-wrap" aria-hidden="true">
                <img src={card.image} alt="" class="card-bg-img" loading="lazy" decoding="async" />
                <div class="card-scrim"></div>
              </div>
            )}

            <div class="card-top-row font-mono">
              <span class="card-step-num">{card.number}</span>
              <span class="card-metric-tag">{card.metric}</span>
            </div>

            {!card.image && (
              <div class="card-diagram" aria-hidden="true">
              {card.diagramType === "fire" && (
                <svg viewBox="0 0 280 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="16" y="16" width="248" height="148" stroke="white" stroke-width="1.4"/>
                  <line x1="98" y1="16" x2="98" y2="164" stroke="white" stroke-width="1" stroke-dasharray="4 4"/>
                  <line x1="182" y1="16" x2="182" y2="164" stroke="white" stroke-width="1" stroke-dasharray="4 4"/>
                  <line x1="16" y1="90" x2="264" y2="90" stroke="white" stroke-width="1" stroke-dasharray="4 4"/>
                  <circle cx="140" cy="90" r="24" stroke="white" stroke-width="1.5"/>
                  <circle cx="140" cy="90" r="52" stroke="white" stroke-width="1.2" stroke-dasharray="6 5"/>
                  <path d="M140 72C146 81 153 86 153 96C153 104 147 110 140 110C133 110 127 104 127 96C127 86 134 81 140 72Z" stroke="white" stroke-width="1.5"/>
                  <path d="M140 52L140 32M178 90L198 90M102 90L82 90M140 128L140 148" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              )}

              {card.diagramType === "logging" && (
                <svg viewBox="0 0 280 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="16" y="16" width="248" height="148" stroke="white" stroke-width="1.4"/>
                  <path d="M36 142L118 48L204 142" stroke="white" stroke-width="1.5"/>
                  <path d="M128 142L188 72L244 142" stroke="white" stroke-width="1.2" stroke-dasharray="5 5"/>
                  <line x1="36" y1="142" x2="244" y2="142" stroke="white" stroke-width="1.4"/>
                  <!-- Stumps & Cut Lines -->
                  <line x1="78" y1="94" x2="158" y2="94" stroke="white" stroke-width="1.4" stroke-dasharray="6 4"/>
                  <circle cx="118" cy="48" r="4" fill="white"/>
                  <rect x="82" y="128" width="12" height="14" stroke="white" stroke-width="1.4"/>
                  <rect x="142" y="128" width="12" height="14" stroke="white" stroke-width="1.4"/>
                </svg>
              )}

              {card.diagramType === "flood" && (
                <svg viewBox="0 0 280 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="16" y="16" width="248" height="148" stroke="white" stroke-width="1.4"/>
                  <!-- Slope erosion & Village flood level -->
                  <path d="M28 42L116 130H252" stroke="white" stroke-width="1.5"/>
                  <path d="M52 42L132 122" stroke="white" stroke-width="1.2" stroke-dasharray="4 4"/>
                  <line x1="116" y1="106" x2="252" y2="106" stroke="white" stroke-width="1.4" stroke-dasharray="7 4"/>
                  <!-- Village Houses + Highest Red Flag House Schematic -->
                  <path d="M148 130V112L160 102L172 112V130" stroke="white" stroke-width="1.4"/>
                  <path d="M196 122V104L208 94L220 104V122" stroke="white" stroke-width="1.4"/>
                  <line x1="208" y1="94" x2="208" y2="74" stroke="white" stroke-width="1.4"/>
                  <rect x="208" y="74" width="14" height="9" stroke="white" stroke-width="1.4"/>
                </svg>
              )}

              {card.diagramType === "wildlife" && (
                <svg viewBox="0 0 280 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="16" y="16" width="248" height="148" stroke="white" stroke-width="1.4"/>
                  <!-- Fragmented Forest Clusters & Broken Corridor -->
                  <circle cx="76" cy="90" r="34" stroke="white" stroke-width="1.5"/>
                  <circle cx="76" cy="90" r="18" stroke="white" stroke-width="1" stroke-dasharray="3 3"/>
                  <circle cx="204" cy="90" r="34" stroke="white" stroke-width="1.5"/>
                  <circle cx="204" cy="90" r="18" stroke="white" stroke-width="1" stroke-dasharray="3 3"/>
                  <line x1="110" y1="90" x2="170" y2="90" stroke="white" stroke-width="1.5" stroke-dasharray="5 5"/>
                  <path d="M134 82L146 98M146 82L134 98" stroke="white" stroke-width="1.6"/>
                  <circle cx="76" cy="90" r="3.5" fill="white"/>
                  <circle cx="204" cy="90" r="3.5" fill="white"/>
                </svg>
              )}
              </div>
            )}

            <div class="card-bottom">
              <h3 class="card-title font-display">{card.title}</h3>
              <p class="card-desc">{card.description}</p>
              <span class="story-badge">{card.badge}</span>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom Interactive Carousel Controls (Progress + Prev/Next Buttons) -->
    <div class="domino-controls">
      <div class="domino-status font-mono">
        <span id="domino-current-idx">01</span>
        <span class="domino-sep">/</span>
        <span>0{domino.cards.length}</span>
        <div class="domino-progress-track" aria-hidden="true">
          <div class="domino-progress-fill" id="domino-progress-fill"></div>
        </div>
        <span class="domino-swipe-hint">GESER ATAU TARIK</span>
      </div>

      <div class="domino-nav-btns">
        <button
          type="button"
          class="domino-arrow-btn"
          id="domino-prev"
          aria-label="Kartu sebelumnya"
          disabled
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12.5 8H3.5M3.5 8L7.5 4M3.5 8L7.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="domino-arrow-btn"
          id="domino-next"
          aria-label="Kartu berikutnya"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>(".domino-track-wrap");
  const track = document.getElementById("domino-track");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".story-card"));
  const prevBtn = document.getElementById("domino-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("domino-next") as HTMLButtonElement | null;
  const currentIdxEl = document.getElementById("domino-current-idx");
  const progressFill = document.getElementById("domino-progress-fill");

  const TOTAL_STEPS = Math.max(1, cards.length - 1); // 3 langkah untuk 4 kartu (01 -> 02 -> 03 -> 04)
  const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

  let targetX = 0;
  let currentX = 0;
  let rafId = 0;
  let isDragging = false;

  function getMaxShift() {
    if (!wrap || !track) return 0;
    return Math.max(0, track.scrollWidth - wrap.clientWidth);
  }

  function syncUI() {
    const maxShift = Math.max(1, getMaxShift());
    const ratio = clamp(targetX / maxShift, 0, 1);

    if (progressFill) {
      progressFill.style.transform = `scaleX(${(0.25 + ratio * 0.75).toFixed(3)})`;
    }

    const activeIdx = Math.round(ratio * TOTAL_STEPS);
    if (currentIdxEl) {
      currentIdxEl.textContent = `0${activeIdx + 1}`;
    }

    if (prevBtn) prevBtn.disabled = targetX <= 4;
    if (nextBtn) nextBtn.disabled = targetX >= maxShift - 4;
  }

  function animateTrack() {
    if (!track) return;
    const ease = isDragging ? 0.38 : 0.16;
    currentX += (targetX - currentX) * ease;
    if (Math.abs(targetX - currentX) < 0.25) {
      currentX = targetX;
      track.style.transform = `translate3d(${-currentX.toFixed(1)}px, 0, 0)`;
      rafId = 0;
      return;
    }
    track.style.transform = `translate3d(${-currentX.toFixed(1)}px, 0, 0)`;
    rafId = requestAnimationFrame(animateTrack);
  }

  function setTargetX(next: number) {
    targetX = clamp(next, 0, getMaxShift());
    syncUI();
    if (!rafId) {
      rafId = requestAnimationFrame(animateTrack);
    }
  }

  function stepBy(dir: number) {
    const maxShift = getMaxShift();
    if (maxShift <= 0) return;
    const stepSize = maxShift / TOTAL_STEPS;
    const currentStep = Math.round(targetX / stepSize);
    const nextStep = clamp(currentStep + dir, 0, TOTAL_STEPS);
    setTargetX(nextStep * stepSize);
  }

  if (wrap && track) {
    if (prevBtn) prevBtn.addEventListener("click", () => stepBy(-1));
    if (nextBtn) nextBtn.addEventListener("click", () => stepBy(1));

    // Trackpad horizontal swipe & Mouse Shift+Scroll
    wrap.addEventListener(
      "wheel",
      (e) => {
        const isTrackpadX = Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 2;
        const isShiftScroll = e.shiftKey && Math.abs(e.deltaY) > 2;
        if (isTrackpadX || isShiftScroll) {
          e.preventDefault();
          e.stopPropagation();
          const rawDelta = isTrackpadX ? e.deltaX : e.deltaY;
          const step = isShiftScroll ? clamp(rawDelta * 0.9, -200, 200) : clamp(rawDelta * 0.55, -100, 100);
          setTargetX(targetX + step);
        }
      },
      { passive: false }
    );

    // Pointer drag & touch swipe with flick momentum
    let startX = 0;
    let startY = 0;
    let dragStartTarget = 0;
    let lockAxis: "x" | "y" | null = null;
    let lastMoveX = 0;
    let lastMoveT = 0;
    let velocityX = 0;

    wrap.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 && e.pointerType === "mouse") return;
      isDragging = true;
      lockAxis = null;
      startX = e.clientX;
      startY = e.clientY;
      lastMoveX = e.clientX;
      lastMoveT = performance.now();
      velocityX = 0;
      dragStartTarget = targetX;
      wrap.classList.add("is-dragging");
      if (e.pointerType === "mouse") {
        wrap.setPointerCapture(e.pointerId);
      }
    });

    wrap.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      if (!lockAxis) {
        if (Math.abs(dx) < 5 && Math.abs(dy) < 5) return;
        lockAxis = Math.abs(dx) >= Math.abs(dy) ? "x" : "y";
        if (lockAxis === "x" && e.pointerType !== "mouse") {
          try {
            wrap.setPointerCapture(e.pointerId);
          } catch {}
        }
      }

      if (lockAxis === "x") {
        const now = performance.now();
        const dt = Math.max(8, now - lastMoveT);
        velocityX = (e.clientX - lastMoveX) / dt;
        lastMoveX = e.clientX;
        lastMoveT = now;

        const gain = e.pointerType === "mouse" ? 1.0 : 1.15;
        setTargetX(dragStartTarget - dx * gain);
      }
    });

    const endDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      wrap.classList.remove("is-dragging");
      if (wrap.hasPointerCapture(e.pointerId)) {
        wrap.releasePointerCapture(e.pointerId);
      }
      if (lockAxis === "x" && Math.abs(velocityX) > 0.15) {
        const inertia = clamp(-velocityX * 220, -340, 340);
        setTargetX(targetX + inertia);
      }
      velocityX = 0;
    };

    wrap.addEventListener("pointerup", endDrag);
    wrap.addEventListener("pointercancel", endDrag);
    window.addEventListener("resize", () => setTargetX(targetX), { passive: true });

    syncUI();
  }
</script>

<style>
  .domino-horizontal-section {
    position: relative;
    z-index: 4;
    margin-top: -100vh;
    min-height: 100vh;
    background-color: var(--color-ash-canvas);
    color: var(--color-charcoal);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(84px, 11vh, 116px) 0 clamp(56px, 8vh, 88px);
    box-sizing: border-box;
  }

  .domino-sticky {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .domino-header-center {
    width: 100%;
    max-width: 1020px;
    margin: 0 auto clamp(20px, 3vh, 32px);
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .domino-giant-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: clamp(12px, 1.8vw, 24px);
    font-size: clamp(68px, 9vw, 132px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: 0.02em;
    margin: 0 0 12px 0;
  }

  .title-top {
    color: rgba(46, 37, 33, 0.64);
  }

  .title-bottom {
    color: var(--color-charcoal);
  }

  .domino-intro-sub {
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.5;
    color: rgba(46, 37, 33, 0.82);
    max-width: 640px;
    margin: 0 auto;
  }

  /* Interactive Horizontal Carousel Track (Lerped & Damped) */
  .domino-track-wrap {
    width: 100%;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
  }

  .domino-track-wrap.is-dragging {
    cursor: grabbing;
  }

  .domino-track {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.5vw, 32px);
    padding: 4px clamp(24px, 8vw, 140px);
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  @media (max-width: 640px) {
    .domino-track {
      padding: 4px 24px;
    }
  }

  .story-card {
    position: relative;
    overflow: hidden;
    flex: 0 0 clamp(360px, 36vw, 490px);
    height: clamp(380px, 52vh, 480px);
    background-color: #3d4f41;
    border-radius: 16px;
    padding: clamp(24px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    scroll-snap-align: center;
  }

  /* Bottom Carousel Controls */
  .domino-controls {
    width: 100%;
    max-width: var(--container-max);
    margin: clamp(22px, 3vh, 32px) auto 0;
    padding: 0 clamp(24px, 8vw, 140px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .domino-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .domino-sep {
    opacity: 0.45;
  }

  .domino-progress-track {
    width: clamp(80px, 14vw, 160px);
    height: 2px;
    background-color: rgba(46, 37, 33, 0.18);
    margin: 0 6px;
    overflow: hidden;
  }

  .domino-progress-fill {
    width: 100%;
    height: 100%;
    background-color: var(--color-charcoal);
    transform-origin: left center;
    transform: scaleX(0.25);
    transition: transform 0.2s ease;
  }

  .domino-swipe-hint {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(46, 37, 33, 0.58);
  }

  .domino-nav-btns {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .domino-arrow-btn {
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    border: 1px solid rgba(46, 37, 33, 0.28);
    background-color: var(--color-cream);
    color: var(--color-charcoal);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  .domino-arrow-btn:hover:not(:disabled) {
    background-color: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  .domino-arrow-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .domino-controls {
      padding: 0 24px;
    }
    .domino-swipe-hint {
      display: none;
    }
  }

  .card-media-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .card-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.78) contrast(1.06) saturate(0.82) sepia(0.12);
  }

  .card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(28, 36, 29, 0.48) 0%,
      rgba(28, 36, 29, 0.16) 42%,
      rgba(20, 24, 20, 0.84) 100%
    );
  }

  .card-top-row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: rgba(252, 246, 236, 0.72);
  }

  .card-step-num {
    font-weight: 600;
    color: var(--color-leaf-accent);
  }

  .card-metric-tag {
    color: var(--color-cream);
  }

  .card-diagram {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 290px;
    margin: 0 auto;
    display: grid;
    place-items: center;
    color: var(--color-cream);
  }

  .card-diagram svg {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.95;
  }

  .card-bottom {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .card-title {
    font-size: clamp(26px, 2.5vw, 34px);
    color: var(--color-cream);
    line-height: 0.95;
  }

  .card-desc {
    font-size: clamp(12.5px, 1.1vw, 14px);
    line-height: 1.48;
    color: rgba(252, 246, 236, 0.86);
    margin-bottom: 4px;
  }

  .story-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 18px;
    border: 1px solid rgba(252, 246, 236, 0.75);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-cream);
  }
</style>
