---
import { learnContent } from "../../data/content";

const { categories, newsHeading, newsMeta, newsList } = learnContent;

const dateFmt = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Asia/Jakarta"
});
const formatDate = (iso: string) => dateFmt.format(new Date(iso));

const countFor = (cat: string) =>
  cat === "Semua"
    ? newsList.length
    : newsList.filter((n) => n.category === cat || n.secondaryCategory === cat).length;

const maxWindow = Math.max(...Object.values(newsMeta.windowDays), 7);
const hasAny = newsList.length > 0;
---

<section class="news-feed-section" data-nav-theme="light">
  <div class="container">
    <div class="nf-header" data-reveal>
      <span class="eyebrow nf-eyebrow">{newsHeading.eyebrow}</span>
      <h2 class="nf-title font-display">{newsHeading.title}</h2>
      <p class="nf-desc">{newsHeading.description}</p>
      <p class="nf-meta font-mono">
        Diperbarui {formatDate(newsMeta.generatedAt)} · jendela waktu 7–{maxWindow} hari terakhir
      </p>
    </div>

    <div class="nf-filters" role="tablist" aria-label="Filter kategori berita" data-reveal>
      {categories.map((cat, idx) => {
        const n = countFor(cat);
        return (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["filter-pill", { active: idx === 0, "is-empty": n === 0 }]}
            data-category={cat}
          >
            {cat}
            <span class="pill-count">{n}</span>
          </button>
        );
      })}
    </div>

    <div class="nf-empty" id="nf-empty" role="status" hidden={hasAny}>
      <strong id="nf-empty-title">Belum ada berita yang terkumpul.</strong>
      <span id="nf-empty-text">
        Pengumpulan berita berjalan otomatis. Coba lagi nanti.
      </span>
    </div>

    <div class="nf-grid" id="nf-grid">
      {newsList.map((item) => (
        <article
          class="news-card"
          data-news-cat={item.category}
          data-news-cat2={item.secondaryCategory ?? ""}
          data-reveal
        >
          <div class="news-card-top">
            {item.image && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="news-thumb-wrap"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="news-thumb"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.parentElement.style.display='none'"
                />
              </a>
            )}

            <div class="news-card-body">
              <div class="news-card-meta font-mono">
                <div class="news-badges">
                  <span class="news-cat-tag">{item.category}</span>
                  {item.secondaryCategory && (
                    <span class="news-cat-tag news-cat-tag--alt">
                      · {item.secondaryCategory}
                    </span>
                  )}
                </div>
                <time class="news-date" datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
              </div>

              <h3 class="news-title">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              </h3>
              {item.summary && <p class="news-summary">{item.summary}</p>}
            </div>
          </div>

          <div class="news-footer font-mono">
            <div class="news-source">
              <span class="src-name">{item.source}</span>
              {item.location && (
                <>
                  <span class="src-sep" aria-hidden="true">·</span>
                  <span class="src-loc">{item.location}</span>
                </>
              )}
            </div>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="news-link"
            >
              <span>Sumber</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="nf-footnote">{newsHeading.attribution}</p>
  </div>
</section>

<script define:vars={{ maxWindow }}>
  const filterBtns = document.querySelectorAll(".filter-pill");
  const newsCards = document.querySelectorAll(".news-card");
  const emptyBox = document.getElementById("nf-empty");
  const emptyTitle = document.getElementById("nf-empty-title");
  const emptyText = document.getElementById("nf-empty-text");

  function applyFilter(selected) {
    let visible = 0;
    newsCards.forEach((card) => {
      const show =
        selected === "Semua" ||
        card.dataset.newsCat === selected ||
        card.dataset.newsCat2 === selected;
      card.style.display = show ? "flex" : "none";
      if (show) visible += 1;
    });

    if (visible === 0) {
      if (selected === "Semua") {
        emptyTitle.textContent = "Belum ada berita yang terkumpul.";
        emptyText.textContent = "Pengumpulan berita berjalan otomatis. Coba lagi nanti.";
      } else {
        emptyTitle.textContent = `Belum ada berita “${selected}” dalam ${maxWindow} hari terakhir.`;
        emptyText.textContent = "Kategori ini kosong untuk periode ini. Coba kategori lain atau pilih “Semua”.";
      }
      emptyBox.hidden = false;
    } else {
      emptyBox.hidden = true;
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.category || "Semua";
      filterBtns.forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");
      applyFilter(selected);
    });
  });
</script>

<style>
  .news-feed-section {
    background-color: var(--color-ash-canvas);
    color: var(--color-charcoal);
    padding: var(--space-band) 0;
  }

  .nf-header {
    max-width: 780px;
    margin-bottom: 36px;
  }

  .nf-eyebrow {
    color: var(--color-ember);
    margin-bottom: 12px;
  }

  .nf-title {
    font-size: clamp(44px, 6vw, 84px);
    color: var(--color-charcoal);
    margin-bottom: 14px;
  }

  .nf-desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(46, 37, 33, 0.82);
  }

  .nf-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }

  .filter-pill {
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(46, 37, 33, 0.25);
    background-color: var(--color-neutral-1);
    color: var(--color-charcoal);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .filter-pill:hover {
    background-color: var(--color-cream);
  }

  .filter-pill.active {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    border-color: var(--color-charcoal);
  }

  .nf-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .news-card {
    background-color: var(--color-cream);
    border: 1px solid rgba(46, 37, 33, 0.18);
    border-radius: var(--radius-sm);
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease;
  }

  .news-card:hover {
    border-color: rgba(46, 37, 33, 0.45);
  }

  .news-card-top {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: stretch;
    flex: 1;
  }

  .news-thumb-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 176px;
    overflow: hidden;
    background-color: var(--color-neutral-1);
    display: block;
  }

  .news-thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .news-card:hover .news-thumb {
    transform: scale(1.03);
  }

  .news-card-body {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .news-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
    margin-bottom: 8px;
  }

  .news-cat-tag {
    font-weight: 600;
    color: var(--color-ember);
    text-transform: uppercase;
  }

  .news-cat-tag--alt {
    color: rgba(46, 37, 33, 0.62);
    font-weight: 500;
  }

  .news-date {
    color: rgba(46, 37, 33, 0.55);
  }

  .news-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    margin-bottom: 8px;
  }

  .news-title a {
    color: inherit;
    text-decoration: none;
  }

  .news-card:hover .news-title a {
    opacity: 0.72;
  }

  .news-summary {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(34, 34, 34, 0.78);
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-top: 1px solid rgba(46, 37, 33, 0.12);
    font-size: 11.5px;
  }

  .news-source {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .src-name {
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .src-sep {
    color: rgba(46, 37, 33, 0.4);
  }

  .src-loc {
    color: rgba(46, 37, 33, 0.65);
  }

  .news-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-charcoal);
    flex-shrink: 0;
  }

  .news-link:hover {
    opacity: 0.6;
  }

  .nf-meta {
    font-size: 12px;
    color: rgba(46, 37, 33, 0.65);
    margin-top: 14px;
  }

  .pill-count {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.6;
  }

  .filter-pill.is-empty:not(.active) {
    color: rgba(46, 37, 33, 0.5);
    border-style: dashed;
  }

  .news-cat-badge--alt {
    background-color: transparent;
    color: var(--color-charcoal);
    border: 1px solid rgba(46, 37, 33, 0.4);
    margin-left: 6px;
  }

  .news-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .nf-empty {
    border: 1px dashed rgba(46, 37, 33, 0.35);
    border-radius: var(--radius-sm);
    background-color: var(--color-cream);
    padding: 40px 28px;
    text-align: center;
    color: rgba(46, 37, 33, 0.82);
  }

  .nf-empty[hidden] {
    display: none;
  }

  .nf-empty strong {
    display: block;
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--color-charcoal);
  }

  .nf-footnote {
    margin-top: 28px;
    font-size: 12.5px;
    line-height: 1.5;
    color: rgba(46, 37, 33, 0.62);
  }

  @media (max-width: 960px) {
    .nf-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .news-card-top {
      grid-template-columns: 118px 1fr;
    }

    .news-thumb-wrap {
      min-height: 140px;
    }

    .news-card-body {
      padding: 14px;
    }

    .news-title {
      font-size: 16px;
    }
  }
</style>
