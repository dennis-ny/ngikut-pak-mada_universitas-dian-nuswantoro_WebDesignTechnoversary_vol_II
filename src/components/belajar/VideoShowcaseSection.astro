---
import { learnContent } from "../../data/content";

const { videoShowcase } = learnContent;
---

<section class="video-showcase-section">
  <div class="container">
    <div class="vs-header" data-reveal>
      <span class="eyebrow vs-eyebrow">{videoShowcase.eyebrow}</span>
      <h1 class="vs-title font-display">{videoShowcase.title}</h1>
      <p class="vs-subtitle">{videoShowcase.subtitle}</p>
    </div>

    <div class="vs-grid" data-reveal>
      <div class="vs-player-col">
        <div class="vs-player-frame">
          <video
            id="ashen-intro-video"
            class="vs-video"
            controls
            playsinline
            preload="metadata"
            poster={videoShowcase.posterUrl}
          >
            <source src={videoShowcase.videoUrl} type="video/mp4" />
            Browser Anda tidak mendukung pemutar video HTML5.
          </video>

          <div class="vs-player-bar font-mono">
            <span>SCREEN RECORD + VOICE OVER</span>
            <span id="vs-active-chapter">
              {videoShowcase.chapters[0]?.time} — {videoShowcase.chapters[0]?.title}
            </span>
            <span>DURASI {videoShowcase.duration}</span>
          </div>
        </div>
        <p class="vs-note font-mono">{videoShowcase.narratorNote}</p>
      </div>

      <div class="vs-chapters-col">
        <div class="chapters-head font-mono">
          <span>DAFTAR BAB (CHAPTERS)</span>
          <span>KLIK UNTUK LOMPAT</span>
        </div>

        <div class="chapters-list">
          {videoShowcase.chapters.map((ch, idx) => (
            <button
              type="button"
              class:list={["chapter-btn", { active: idx === 0 }]}
              data-seconds={ch.seconds}
              data-label={`${ch.time} — ${ch.title}`}
            >
              <div class="ch-top">
                <span class="ch-time font-mono">{ch.time}</span>
                <span class="ch-title">{ch.title}</span>
              </div>
              <p class="ch-desc">{ch.description}</p>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("ashen-intro-video") as HTMLVideoElement | null;
  const activeLabel = document.getElementById("vs-active-chapter");
  const chapterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".chapter-btn"));
  let lastActiveIdx = 0;

  function setActiveChapter(targetIdx: number) {
    if (targetIdx === lastActiveIdx || !chapterBtns[targetIdx]) return;
    lastActiveIdx = targetIdx;
    chapterBtns.forEach((b, idx) => b.classList.toggle("active", idx === targetIdx));
    const lbl = chapterBtns[targetIdx].dataset.label || "";
    if (activeLabel && lbl) {
      activeLabel.textContent = lbl;
    }
  }

  chapterBtns.forEach((btn, idx) => {
    btn.addEventListener("click", () => {
      const sec = Number(btn.dataset.seconds || "0");
      setActiveChapter(idx);

      if (video) {
        if (video.readyState >= 1) {
          video.currentTime = sec;
        } else {
          video.addEventListener("loadedmetadata", () => {
            video.currentTime = sec;
          }, { once: true });
        }
        video.play().catch(() => {});
      }
    });
  });

  if (video) {
    video.addEventListener("timeupdate", () => {
      const t = video.currentTime;
      let nextIdx = 0;
      for (let i = 0; i < chapterBtns.length; i++) {
        const sec = Number(chapterBtns[i].dataset.seconds || "0");
        if (t >= sec) nextIdx = i;
      }
      setActiveChapter(nextIdx);
    });
  }
</script>

<style>
  .video-showcase-section {
    position: relative;
    overflow: hidden;
    background-color: var(--color-charcoal-deep);
    background-image:
      radial-gradient(ellipse 65% 55% at 85% 18%, rgba(224, 86, 28, 0.11) 0%, rgba(242, 169, 59, 0.04) 45%, transparent 72%),
      url("/images/topo-contours.svg"),
      linear-gradient(180deg, #1a1411 0%, var(--color-charcoal-deep) 55%, #191411 100%);
    background-repeat: no-repeat, no-repeat, no-repeat;
    background-size: auto, min(100%, 1440px) auto, auto;
    background-position: center, right top, center;
    color: var(--color-cream);
    padding: 140px 0 var(--space-section);
    border-bottom: 1px solid rgba(252, 246, 236, 0.1);
  }

  .vs-header {
    max-width: 820px;
    margin-bottom: 44px;
  }

  .vs-eyebrow {
    color: var(--color-smoke-amber);
    margin-bottom: 14px;
  }

  .vs-title {
    font-size: clamp(48px, 6.5vw, 88px);
    color: var(--color-cream);
    margin-bottom: 16px;
  }

  .vs-subtitle {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(252, 246, 236, 0.8);
  }

  .vs-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.95fr;
    gap: 28px;
    align-items: start;
  }

  .vs-player-frame {
    background-color: var(--color-charcoal);
    border: 1px solid rgba(252, 246, 236, 0.14);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .vs-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #120e0c;
    object-fit: cover;
  }

  .vs-player-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 20px;
    font-size: 11px;
    background-color: #251e1a;
    color: rgba(252, 246, 236, 0.75);
    border-top: 1px solid rgba(252, 246, 236, 0.1);
  }

  .vs-note {
    margin-top: 12px;
    font-size: 12px;
    color: rgba(252, 246, 236, 0.58);
  }

  .vs-chapters-col {
    background-color: var(--color-charcoal);
    border: 1px solid rgba(252, 246, 236, 0.12);
    border-radius: var(--radius-sm);
    padding: 20px;
  }

  .chapters-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: rgba(252, 246, 236, 0.55);
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(252, 246, 236, 0.1);
  }

  .chapters-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chapter-btn {
    width: 100%;
    text-align: left;
    background-color: rgba(252, 246, 236, 0.04);
    border: 1px solid rgba(252, 246, 236, 0.08);
    border-radius: var(--radius-xs);
    padding: 14px 16px;
    color: var(--color-cream);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .chapter-btn:hover {
    background-color: rgba(252, 246, 236, 0.09);
  }

  .chapter-btn.active {
    background-color: rgba(224, 86, 28, 0.16);
    border-color: var(--color-ember);
  }

  .ch-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .ch-time {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 4px;
    background-color: var(--color-ember);
    color: var(--color-cream);
    font-weight: 600;
  }

  .ch-title {
    font-size: 14px;
    font-weight: 600;
  }

  .ch-desc {
    font-size: 12.5px;
    line-height: 1.5;
    color: rgba(252, 246, 236, 0.72);
  }

  @media (max-width: 980px) {
    .vs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
